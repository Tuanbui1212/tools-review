# Copy thành .env rồi đổi mật khẩu.

# --- Docker Compose (main/docker-compose.yml) ---
POSTGRES_USER=crt
POSTGRES_PASSWORD=crt
POSTGRES_DB=crt
MINIO_ROOT_USER=crt-minio
MINIO_ROOT_PASSWORD=crt-minio-secret
S3_BUCKET=crt-files

# --- Đăng nhập (M01). Bắt buộc đổi JWT_SECRET khi ENVIRONMENT=production ---
ENVIRONMENT=development
JWT_SECRET=dev-only-insecure-jwt-secret-change-me-in-production
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
LOGIN_MAX_FAILED=5
LOGIN_LOCK_MINUTES=15

# --- Chạy API trực tiếp trên máy (không qua Docker) ---
DATABASE_URL=postgresql+psycopg://crt:crt@localhost:5432/crt
REDIS_URL=redis://localhost:6379/0
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=crt-minio
S3_SECRET_KEY=crt-minio-secret
